{
  "name": "kairu-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Production Kairu Discord gateway, commands, reconciliation jobs, and secure webhooks",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "register:commands": "tsx src/scripts/register-commands.ts",
    "db:migrate": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
