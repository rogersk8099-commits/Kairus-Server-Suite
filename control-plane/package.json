{
  "name": "kairu-control-plane",
  "version": "1.0.0",
  "private": true,
  "description": "Railway-hosted API control plane and Discord bot for Kairu SMP",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx scripts/migrate.ts",
    "register-commands": "tsx scripts/register-commands.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "discord.js": "^14.21.0",
    "fastify": "^5.3.3",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
