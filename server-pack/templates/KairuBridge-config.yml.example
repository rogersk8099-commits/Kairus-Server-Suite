# Copy to plugins/KairuBridge/config.yml after the first server start.
# Keep this populated file server-side and out of source control and browser-accessible paths.
server-id: "replace-with-a-stable-server-id"
api-base-url: "https://your-control-plane.example"
api-key: "CHANGE_ME"

http:
  connect-timeout-seconds: 10
  request-timeout-seconds: 15
  max-retries: 3
  retry-base-delay-millis: 500

heartbeat:
  enabled: true
  interval-seconds: 30
snapshots:
  enabled: true
  interval-seconds: 300
commands:
  enabled: true
  poll-interval-seconds: 15
link:
  snapshot-after-link: true
